miR-339-3p]]#🔗 關聯文獻與紀錄#{1}":[42,48]},"outlinks":[{"title":"KJA to Phytomedicine Pivot: GiEVs & miR-339-3p","target":"KJA to Phytomedicine Pivot: GiEVs & miR-339-3p","line":12},{"title":"原始稿件草案","target":"_inbox/KJA/KJA-S-26-00422.pdf","line":46},{"title":"任務進度追蹤","target":"_inbox/tasks.md","line":47}],"metadata":{"type":"academic","status":null,"tags":null,"BG":"Ginger-derived extracellular vesicles (GiEVs) carrying miR-339-3p attenuate aspiration-induced lung injury (ALI).","GAP":"KJA Editor pointed out lacking survival data, long-term follow-up, and questioned the novelty/anti-inflammatory evidence of miR-339-3p.","RQ":"Do GiEVs significantly improve 48h/long-term survival and pulmonary integrity via miR-339-3p mediated anti-inflammatory pathways in ALI?","METH":"C57BL/6 mice, oropharyngeal aspiration model, GiEV treatment (1x10^9), survival analysis, lung function, BALF WBC, miR-339-3p inhibition.","CONTRI":"Demonstrating trans-kingdom regulation of lung inflammation by plant-derived EVs; providing necessary survival metrics for clinical translation."},"task_lines":[],"tasks":{},"codeblock_ranges":[[42,45]]},"smart_blocks:100_Research/02_Active/AP_GiNV/99_Staging_Area/KJA_to_Phytomedicine_Pivot.md#---frontmatter---": {"path":null,"last_embed":{"hash":"zu36fm","at":1777948247844},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07268097,-0.02652103,0.03682924,0.02134991,0.06436122,-0.01211538,0.01833439,0.07360031,-0.02946321,0.05853518,0.00684205,-0.08189158,0.03336826,0.00351514,0.02556143,0.03754073,0.02451632,0.01515116,-0.14963952,0.02411543,0.00113558,-0.02030239,0.07809798,0.00892703,0.05775126,0.0107635,-0.00581865,-0.02842488,-0.03922895,-0.21697566,-0.0563031,-0.00766957,0.03204535,0.01390433,-0.0484135,0.00326782,-0.06313732,0.04541395,-0.04231022,0.07089871,0.07293522,0.02759368,-0.00922072,0.03583249,0.01086273,-0.01960248,-0.06612996,-0.03497441,0.01000736,-0.0494117,0.02565408,-0.01424927,0.01810197,0.05191707,-0.00678152,0.01691799,0.06924558,0.042