arget":"https://blackmomo.tw/wp-content/uploads/20200611165653_33.png","line":79},{"title":"![ICON_IG","target":"https://blackmomo.tw/wp-content/uploads/20200611165732_68.png","line":79}],"metadata":{"title":"台南｜沙淘宮廟海產・老派平價海產店，碳烤熱炒都有水準","source":"https://blackmomo.tw/shataogong/","author":null,"published":"2026-01-14","created":"2026-04-29","description":"台南式的晚餐宵夜去哪吃？坐在廟埕前吃熱炒最有味道，不過已搬離廟口的「 沙淘宮廟海產 」，依舊保留那份老台南的夜晚節奏！沒有裝潢的老派平價海產店，以關東煮、碳烤、小炒為主角，端上桌的熱炒與烤物都有水準，簡單又美味，而招牌關東煮、炸豬排、蛋包飯獲得《米其林指南》的推薦，是在地人日常的晚餐與宵夜選擇。 台南海產店推薦 沙淘宮","tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:Clippings/台南｜沙淘宮廟海產・老派平價海產店，碳烤熱炒都有水準.md#---frontmatter---": {"path":null,"last_embed":{"hash":"1capkf9","at":1777417988761},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06417859,-0.01928564,0.01224647,-0.04413263,0.0573113,-0.01999074,-0.01592718,-0.0054069,0.0225761,-0.00186391,0.02286607,-0.08989309,0.00847963,0.06329504,0.00069544,0.0008743,0.03662609,-0.01038219,-0.06385834,-0.01970872,0.08995812,-0.04178639,0.00305358,-0.04776346,0.04734955,-0.00299906,0.02326413,-0.02770295,-0.01239957,-0.13103068,0.01331141,0.03036746,0.08571561,0.03135741,0.00025448,-0.04566223,-0.01312693,0.03127562,0.00266979,0.0176035,0.01763345,0.02863746,-0.00393959,0.0220069,-0.03700083,-0.06256555,-0.00121688,-0.02977185,0.0072738,-0.00557142,-0.05782616,-0.01810274,0.00272505,-0.00609078,0.03143423,-0.03766025,0.04862987,0.0358839,0.02697332,0.0302928,0.04316127,0.01912434,-0.21528205,0.05836457,-0.00879935,-0.01624933,0.00246214,0.01573713,0.00439272,0.03513402,-0.04142765,0.02887869,-0.02252632,0.04306043,-0.02591524,-0.00985147,0.04280441,0.01589038,-0.08256412,-0.03802408,0.01528952,0.00734852,0.00930898,-0.01246324,-0.04132208,0.0068347,0.00774434,-0.08476882,-0.03260963,0.02181335,0.02018337,-0.07115255,0.05586731,0.02458468,-0.08049475,-0.03438707,0.01570201,-0.01050433,-0.03308285,0.12175799,-0.05982147,0.01707066,0.04577645,-0.04197856,0.04742326,0.0044485,-0.0138143,-0.07670